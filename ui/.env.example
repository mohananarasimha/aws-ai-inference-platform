# Copy to .env.local (git-ignored). Read only by the BFF (server/bff.mjs); never sent to the browser.
# Values come from the app stack: cd terraform/environments/dev/app && terraform output ...

# terraform output -raw invoke_url
GATEWAY_INVOKE_URL=https://abc123.execute-api.us-east-1.amazonaws.com/invoke
# terraform output -raw cognito_token_endpoint
COGNITO_TOKEN_URL=https://example.auth.us-east-1.amazoncognito.com/oauth2/token
# terraform output -raw m2m_client_id
COGNITO_CLIENT_ID=
# terraform output -raw m2m_client_secret   (secret: keep it in this file only)
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=enterprise-ai-gateway/invoke

# Optional
# BFF_PORT=8787
# Abort the upstream call after this long. API Gateway stops at 30 s; the gateway's own budget is 24 s.
# UPSTREAM_TIMEOUT_MS=29000
