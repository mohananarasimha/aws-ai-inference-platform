{
  "name": "inference-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Optional local UI that exercises the existing API Gateway /invoke endpoint through a small server-side token proxy",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "bff": "node server/bff.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/bff.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
