# Copy to .env (git-ignored). scripts/up.sh and scripts/down.sh read it if present.

# AWS CLI profile to use (default: "default").
AWS_PROFILE=my-profile

# Safety check: the scripts refuse to run against any other account.
# Optional: when unset, the first allowed_account_ids entry in
# terraform/environments/dev/app/terraform.tfvars is used.
EXPECTED_AWS_ACCOUNT_ID=111122223333

# Optional: subnets for the internal vLLM NLB, comma separated. When unset, up.sh
# uses the EKS cluster's own subnets (read with aws eks describe-cluster).
# VLLM_NLB_SUBNETS=subnet-0123456789abcdef0,subnet-0123456789abcdef1
